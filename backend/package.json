{
  "name": "cabanas-backend",
  "version": "1.0.0",
  "description": "API REST para la gestión de reservas de un complejo de cabañas en Potrero de los Funes, San Luis",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "migrar": "node src/seed/migrar.js"
  },
  "keywords": [
    "express",
    "sequelize",
    "postgresql",
    "jwt",
    "api-rest"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "umzug": "^3.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "embedded-postgres": "^17.10.0-beta.17",
    "nodemon": "^3.1.0"
  }
}

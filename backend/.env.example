DATABASE_URL=postgresql://usuario:password@host:puerto/postgres
PORT=3000

# Mínimo 32 caracteres. Generalo con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Dominios autorizados a llamar a la API, separados por coma.
# Si queda vacío la API acepta cualquier origen (sólo aceptable en desarrollo).
# Sin barra final y con el esquema (https://) exacto: se compara contra el
# header Origin tal cual lo manda el navegador.
# Ojo: los preview deploys de Vercel usan otro subdominio y quedan bloqueados.
CORS_ORIGINS=https://cabanas-frontend-three.vercel.app,http://localhost:5173

# Supabase exige SSL. Poné DB_SSL=false sólo para un Postgres local sin SSL.
DB_SSL=
